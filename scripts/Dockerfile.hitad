FROM tensorflow/tensorflow:2.9.3
RUN python -m pip install --no-cache-dir 'numpy==1.23.4' 'Cython==0.29.36' 'scipy==1.10.1' 'networkx==2.8.8' 'scikit-learn==1.3.2' 'matplotlib==3.7.5' 'joblib==1.3.2' 'PyYAML==6.0.1' 'cooler==0.9.3' 'setuptools<70' wheel
RUN python -m pip install --no-cache-dir --no-build-isolation 'pomegranate==0.14.8'
ENV PYTHONPATH=/work/third_party/TADLib
ENV OPENBLAS_NUM_THREADS=1
ENV OMP_NUM_THREADS=1
WORKDIR /work
